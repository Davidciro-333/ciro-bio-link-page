---
/**
 * Lo que juego ahora en PlayStation. Los datos vienen de la cache del Gist
 * (ver CLAUDE.md), así que tienen como mucho ~15 min de retraso.
 */
---

<div id="playstation-card" aria-live="polite">
  <div class="feature" aria-busy="true">
    <span class="feature-cover sk"></span>
    <div>
      <span class="sk sk-line" style="display:block;width:40%"></span>
      <span class="sk sk-line" style="display:block;width:70%;height:20px;margin-top:10px"></span>
      <span class="sk sk-line" style="display:block;width:50%;margin-top:10px"></span>
    </div>
  </div>
</div>

<script>
  import { escapeHtml, setEntryMeta, ICONS } from '../lib/client';

  const card = document.getElementById('playstation-card');
  let current = '';

  async function load() {
    if (!card) return;
    try {
      const res = await fetch('/api/psn-now-playing?ts=' + Date.now());
      const data = await res.json();

      let key: string;
      let html: string;

      if (data.isPlaying) {
        setEntryMeta('juegos', 'jugando ahora');
        key = `play|${data.title}`;
        const cover = data.imageUrl
          ? `<img class="feature-cover" src="${escapeHtml(data.imageUrl)}" alt="" width="96" height="96" />`
          : `<span class="feature-cover is-empty">${ICONS.pad}</span>`;
        html = `
          <div class="feature">
            ${cover}
            <div class="min">
              <span class="state"><span class="flame"></span>Jugando ahora</span>
              <p class="feature-title">${escapeHtml(data.title)}</p>
              <p class="feature-sub">${escapeHtml(data.gamePlatform ?? data.platform ?? 'PlayStation')}</p>
            </div>
          </div>`;
      } else {
        const online = Boolean(data.isOnline);
        setEntryMeta('juegos', online ? 'en línea' : 'desconectado');
        key = `idle|${online}`;
        html = `
          <div class="feature">
            <span class="feature-cover is-empty">${ICONS.pad}</span>
            <div class="min">
              <span class="state${online ? '' : ' is-idle'}">${online ? '<span class="flame"></span>En línea' : 'PlayStation'}</span>
              <p class="feature-title">Ahora no estoy jugando</p>
              <p class="feature-sub">Abajo, mis últimas partidas.</p>
            </div>
          </div>`;
      }

      if (key !== current) {
        current = key;
        card.innerHTML = html;
      }
    } catch {
      current = '';
      setEntryMeta('juegos', 'PlayStation');
      card.innerHTML = `<p class="note">No pude leer PlayStation ahora mismo.</p>`;
    }
  }

  load();
  setInterval(load, 60000);
</script>
