<button class="theme-toggle" id="themeToggle" aria-label="Cambiar tema">🌙</button>

<script>
  const btn = document.getElementById('themeToggle') as HTMLButtonElement;
  const html = document.documentElement;

  const current = html.getAttribute('data-theme') || 'dark';
  btn.textContent = current === 'dark' ? '🌙' : '☀️';

  function apply(next: string) {
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    btn.textContent = next === 'dark' ? '🌙' : '☀️';
  }

  btn.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';

    // View Transitions: el navegador captura el antes y el después y los funde
    // en la GPU, con un único recálculo de estilos. Transicionar los colores de
    // cada elemento con CSS congelaba la página ~400 ms en móvil (ver global.css).
    // Sin soporte, o con movimiento reducido, el cambio es instantáneo.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduceMotion) {
      apply(next);
      return;
    }
    document.startViewTransition(() => apply(next));
  });
</script>
