---
/**
 * Lo que suena ahora en Spotify. Polling cada 35 s; entre medias el hilo de
 * progreso avanza localmente cada segundo.
 */
---

<div id="spotify-card" aria-live="polite">
  <div class="feature" aria-busy="true">
    <span class="feature-cover sk"></span>
    <div>
      <span class="sk sk-line" style="display:block;width:40%"></span>
      <span class="sk sk-line" style="display:block;width:80%;height:20px;margin-top:10px"></span>
      <span class="sk sk-line" style="display:block;width:55%;margin-top:10px"></span>
    </div>
  </div>
</div>

<script>
  import { escapeHtml, formatMs, reducedMotion, setEntryMeta, ICONS } from '../lib/client';

  const card = document.getElementById('spotify-card');
  let timer: ReturnType<typeof setInterval> | null = null;
  let current = '';

  function stopTimer() {
    if (timer) clearInterval(timer);
    timer = null;
  }

  function startTimer(progressMs: number, durationMs: number, fetchedAt: number) {
    stopTimer();
    const fill = document.getElementById('sp-thread');
    const now = document.getElementById('sp-now');
    const tick = () => {
      const pos = Math.min(progressMs + (Date.now() - fetchedAt), durationMs);
      if (fill) fill.style.width = `${(pos / durationMs) * 100}%`;
      if (now) now.textContent = formatMs(pos);
      if (pos >= durationMs) stopTimer();
    };
    tick();
    if (!reducedMotion()) timer = setInterval(tick, 1000);
  }

  async function load() {
    if (!card) return;
    const fetchedAt = Date.now();

    try {
      const res = await fetch('/api/now-playing?ts=' + fetchedAt);
      const song = await res.json();

      if (song.isPlaying) {
        setEntryMeta('musica', 'sonando ahora');
        const key = `${song.title}|${song.artist}`;
        // Misma canción: solo se resincroniza el progreso, sin re-pintar (y sin
        // que el lector de pantalla la anuncie otra vez).
        if (key !== current) {
          current = key;
          const title = escapeHtml(song.title);
          const titleHtml = song.songUrl
            ? `<a href="${escapeHtml(song.songUrl)}" target="_blank" rel="noopener noreferrer">${title}</a>`
            : title;
          card.innerHTML = `
            <div class="feature">
              <img class="feature-cover" src="${escapeHtml(song.albumImageUrl)}" alt="${escapeHtml(song.album ?? '')}" width="96" height="96" />
              <div class="min">
                <span class="state"><span class="flame"></span>Sonando ahora</span>
                <p class="feature-title">${titleHtml}</p>
                <p class="feature-sub">${escapeHtml(song.artist)}</p>
              </div>
            </div>
            <div class="thread" aria-hidden="true"><span class="thread-fill" id="sp-thread"></span></div>
            <div class="times"><span id="sp-now"></span><span>${formatMs(song.durationMs)}</span></div>`;
        }
        if (song.durationMs > 0) startTimer(song.progressMs, song.durationMs, fetchedAt);
        return;
      }

      stopTimer();
      setEntryMeta('musica', 'en silencio');
      if (current === 'idle') return;
      current = 'idle';
      card.innerHTML = `
        <div class="feature">
          <span class="feature-cover is-empty">${ICONS.note}</span>
          <div class="min">
            <span class="state is-idle">Spotify</span>
            <p class="feature-title">Ahora no suena nada</p>
            <p class="feature-sub">Abajo, lo último que escuché.</p>
          </div>
        </div>`;
    } catch {
      stopTimer();
      current = '';
      setEntryMeta('musica', 'Spotify');
      card.innerHTML = `<p class="note">No pude leer Spotify ahora mismo.</p>`;
    }
  }

  load();
  setInterval(load, 35000);
</script>
