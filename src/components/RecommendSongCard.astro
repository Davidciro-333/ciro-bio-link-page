---
/**
 * "Déjame una canción": el visitante busca en Spotify, elige una pista y se
 * añade a la playlist pública (con aviso por Telegram). Solo se envía un
 * trackId, nunca texto libre. Lógica del servidor en /api/recommend-song.
 */
---

<div id="recommend-card" class="ask">
  <label class="ask-title" for="rec-query">Déjame una canción</label>
  <p class="ask-intro">Búscala y la guardo en mi playlist. A ver qué me descubres.</p>
  <input
    id="rec-query"
    type="search"
    class="ask-input"
    placeholder="Canción o artista"
    autocomplete="off"
    aria-controls="rec-results"
  />

  <div id="rec-results" class="rows" aria-live="polite"></div>

  <div id="rec-confirm" class="ask-confirm" hidden>
    <div class="row" style="cursor:default">
      <img id="rec-confirm-cover" class="row-cover" width="44" height="44" alt="" />
      <div class="min">
        <div id="rec-confirm-title" class="row-title"></div>
        <div id="rec-confirm-artist" class="row-sub"></div>
      </div>
      <span></span>
    </div>
    <label class="sr-only" for="rec-from">Tu nombre (opcional)</label>
    <input id="rec-from" type="text" class="ask-input" placeholder="Tu nombre (opcional)" maxlength="40" autocomplete="name" />
    <div class="ask-actions">
      <button id="rec-cancel" type="button" class="btn btn-ghost">Cancelar</button>
      <button id="rec-send" type="button" class="btn btn-lamp">Recomendar</button>
    </div>
  </div>

  <p id="rec-status" class="ask-status" role="status" hidden></p>
</div>

<script>
  import { escapeHtml } from '../lib/client';

  const queryInput = document.getElementById('rec-query') as HTMLInputElement | null;
  const results = document.getElementById('rec-results');
  const confirmBox = document.getElementById('rec-confirm');
  const fromInput = document.getElementById('rec-from') as HTMLInputElement | null;
  const sendBtn = document.getElementById('rec-send') as HTMLButtonElement | null;
  const cancelBtn = document.getElementById('rec-cancel');
  const status = document.getElementById('rec-status');

  if (queryInput && results && confirmBox && sendBtn && cancelBtn && status) {
    let selectedId: string | null = null;
    let debounce: ReturnType<typeof setTimeout>;
    let lastQuery = '';

    const showStatus = (message: string, kind: 'ok' | 'error') => {
      status.textContent = message;
      status.className = `ask-status is-${kind}`;
      status.hidden = false;
    };

    const resetToSearch = () => {
      selectedId = null;
      confirmBox.hidden = true;
      results.innerHTML = '';
      queryInput.value = '';
      if (fromInput) fromInput.value = '';
    };

    async function search(query: string) {
      try {
        const res = await fetch('/api/song-search?q=' + encodeURIComponent(query));
        const tracks = await res.json();

        // Una respuesta lenta de una búsqueda anterior no debe pisar la actual.
        if (query !== lastQuery) return;

        if (!Array.isArray(tracks) || tracks.length === 0) {
          results.innerHTML = `<p class="note" style="padding:10px 0">No encontré nada con eso.</p>`;
          return;
        }

        results.innerHTML = tracks
          .map((t: any) => {
            const name = escapeHtml(t.name);
            const artists = escapeHtml(t.artists);
            const cover = t.imageUrl
              ? `<img class="row-cover" src="${escapeHtml(t.imageUrl)}" alt="" width="44" height="44" loading="lazy" />`
              : `<span class="row-cover" style="background:var(--surface)"></span>`;
            return `
              <div class="row" role="button" tabindex="0"
                   data-id="${escapeHtml(t.id)}" data-name="${name}" data-artists="${artists}"
                   data-cover="${escapeHtml(t.imageUrl ?? '')}" aria-label="Elegir ${name}, de ${artists}">
                ${cover}
                <div class="min"><div class="row-title">${name}</div><div class="row-sub">${artists}</div></div>
                <span></span>
              </div>`;
          })
          .join('');

        results.querySelectorAll<HTMLElement>('.row[data-id]').forEach((el) => {
          el.addEventListener('click', () => selectTrack(el));
          el.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectTrack(el); }
          });
        });
      } catch {
        results.innerHTML = `<p class="note" style="padding:10px 0">No pude buscar ahora mismo.</p>`;
      }
    }

    function selectTrack(el: HTMLElement) {
      selectedId = el.dataset.id ?? null;
      if (!selectedId) return;

      const cover = document.getElementById('rec-confirm-cover') as HTMLImageElement;
      cover.hidden = !el.dataset.cover;
      if (el.dataset.cover) cover.src = el.dataset.cover;
      // dataset devuelve el texto ya des-escapado: textContent lo pinta seguro.
      document.getElementById('rec-confirm-title')!.textContent = el.dataset.name ?? '';
      document.getElementById('rec-confirm-artist')!.textContent = el.dataset.artists ?? '';

      results.innerHTML = '';
      status.hidden = true;
      confirmBox.hidden = false;
      fromInput?.focus();
    }

    async function send() {
      if (!selectedId) return;
      sendBtn.disabled = true;
      sendBtn.textContent = 'Enviando';

      try {
        const res = await fetch('/api/recommend-song', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trackId: selectedId, from: fromInput?.value ?? '' }),
        });
        const data = await res.json();

        if (!res.ok) {
          showStatus(data.error ?? 'No pude guardarla. Inténtalo más tarde.', 'error');
        } else if (data.duplicate) {
          showStatus(`"${data.name}" ya estaba en la playlist. Buen gusto.`, 'ok');
          resetToSearch();
        } else {
          showStatus(`Gracias. "${data.name}" ya está en la playlist.`, 'ok');
          resetToSearch();
        }
      } catch {
        showStatus('No pude guardarla. Inténtalo más tarde.', 'error');
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Recomendar';
      }
    }

    queryInput.addEventListener('input', () => {
      const query = queryInput.value.trim();
      lastQuery = query;
      clearTimeout(debounce);
      if (query.length < 2) {
        results.innerHTML = '';
        return;
      }
      debounce = setTimeout(() => search(query), 350);
    });

    sendBtn.addEventListener('click', send);
    cancelBtn.addEventListener('click', () => {
      confirmBox.hidden = true;
      selectedId = null;
      queryInput.focus();
    });
  }
</script>
