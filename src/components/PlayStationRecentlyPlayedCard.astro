---
/** Últimas partidas: hasta 6 portadas en círculo, en una rejilla de 3. */
---

<div id="psn-recently-card">
  <div class="relics" aria-busy="true">
    {Array.from({ length: 6 }).map(() => (
      <figure class="relic">
        <span class="relic-empty sk"></span>
        <figcaption><span class="sk sk-line" style="display:block;width:70%;margin:0 auto"></span></figcaption>
      </figure>
    ))}
  </div>
</div>

<script>
  import { escapeHtml, timeAgo } from '../lib/client';

  const card = document.getElementById('psn-recently-card');

  async function load() {
    if (!card) return;
    try {
      const res = await fetch('/api/psn-recently-played');
      const games = await res.json();

      if (!Array.isArray(games) || games.length === 0) {
        card.innerHTML = `<p class="note">Todavía no hay partidas por aquí.</p>`;
        return;
      }

      card.innerHTML = `<div class="relics">${games.slice(0, 6).map((g: any) => {
        const title = escapeHtml(g.title);
        const cover = g.imageUrl
          ? `<img src="${escapeHtml(g.imageUrl)}" alt="" width="120" height="120" loading="lazy" />`
          : `<span class="relic-empty"></span>`;
        return `<figure class="relic">${cover}<figcaption>${title}<small>${timeAgo(g.lastPlayedAt)}</small></figcaption></figure>`;
      }).join('')}</div>`;
    } catch {
      card.innerHTML = `<p class="note">No pude leer mis partidas ahora mismo.</p>`;
    }
  }

  load();
  setInterval(load, 5 * 60 * 1000);
</script>
