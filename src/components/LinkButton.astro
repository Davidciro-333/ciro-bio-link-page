---
interface Props {
  title: string;
  url: string;
  /** El enlace principal va en cursiva y con la luz del farol. */
  main?: boolean;
}

const { title, url, main = false } = Astro.props;
// Las páginas del propio sitio (/cripta) se abren en la misma pestaña.
const externo = /^https?:\/\//.test(url);
---

<a href={url} target={externo ? '_blank' : undefined} rel={externo ? 'noopener noreferrer' : undefined} class:list={['link-btn', { 'is-main': main }]}>
  <span class="mk" aria-hidden="true"></span>
  {title}
  <span class="mk" aria-hidden="true"></span>
</a>
