---
interface Props {
  title: string;
  url: string;
  /** El enlace principal va en cursiva y con la luz del farol. */
  main?: boolean;
}

const { title, url, main = false } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class:list={['link-btn', { 'is-main': main }]}>
  <span class="mk" aria-hidden="true"></span>
  {title}
  <span class="mk" aria-hidden="true"></span>
</a>
