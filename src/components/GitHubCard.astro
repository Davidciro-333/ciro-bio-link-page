---
/**
 * Lo que construyo: contribuciones de los últimos 30 días, heatmap del año y
 * los 5 proyectos más recientes. De los repos privados solo llega el nombre,
 * el lenguaje y la fecha (el servidor borra el resto).
 */
---

<div id="github-card">
  <div aria-busy="true">
    <span class="sk sk-line" style="display:block;width:60%;height:40px"></span>
    <span class="sk" style="display:block;height:84px;margin-top:18px"></span>
  </div>
</div>

<script>
  import { escapeHtml, timeAgo, setEntryMeta } from '../lib/client';

  const card = document.getElementById('github-card');

  /** Nivel 0-4 para el color de la celda, en la escala de GitHub. */
  function heatLevel(count: number): number {
    if (count <= 0) return 0;
    if (count <= 2) return 1;
    if (count <= 5) return 2;
    if (count <= 10) return 3;
    return 4;
  }

  /**
   * Cifra del mes + heatmap. Existe para que el widget no parezca abandonado
   * cuando el trabajo reciente está en repos privados: el calendario de GitHub
   * los cuenta, así que el pulso es real aunque la lista no se mueva.
   */
  function activity(a: any): string {
    if (!a || !Array.isArray(a.weeks) || a.weeks.length === 0) return '';

    const lastWeek = a.weeks.length - 1;
    const weeks = a.weeks.map((week: number[], i: number) => {
      // La semana en curso llega incompleta (y la primera puede empezar a media
      // semana): se rellena con huecos para que la rejilla no se descuadre.
      const pad = '<span class="heat-day is-pad"></span>'.repeat(7 - week.length);
      const days = week.map((c) => `<span class="heat-day" data-level="${heatLevel(c)}"></span>`).join('');
      return `<span class="heat-week">${i === lastWeek ? days + pad : pad + days}</span>`;
    }).join('');

    const month = a.last30Days ?? 0;
    const year = a.lastYear ?? 0;
    const streak = a.streak > 1 ? `,<br>racha de ${a.streak} días` : '';

    return `
      <div class="count"><b>${month}</b><span>${month === 1 ? 'contribución' : 'contribuciones'} este mes${streak}</span></div>
      <div class="heatmap" role="img" aria-label="${year} contribuciones en el último año, ${month} en los últimos 30 días">${weeks}</div>`;
  }

  function repo(r: any): string {
    const sub: string[] = [];
    if (r.isPrivate) sub.push('privado');
    else if (r.language) sub.push(escapeHtml(r.language));
    if (r.isContribution && r.owner) sub.push(`en ${escapeHtml(r.owner)}`);
    const meta = sub.length ? `<p class="repo-desc">${sub.join(', ')}</p>` : '';
    const desc = r.description ? `<p class="repo-desc">${escapeHtml(r.description)}</p>` : '';
    const body = `
      <div class="repo-head"><span class="repo-name">${escapeHtml(r.name)}</span><span class="repo-tag">${timeAgo(r.pushedAt)}</span></div>
      ${meta}${desc}`;

    // Los privados no llevan enlace (daría 404).
    return r.url
      ? `<a class="repo" href="${escapeHtml(r.url)}" target="_blank" rel="noopener noreferrer">${body}</a>`
      : `<div class="repo">${body}</div>`;
  }

  async function load() {
    if (!card) return;
    try {
      const res = await fetch('/api/github-activity');
      const data = await res.json();
      const repos = Array.isArray(data.repos) ? data.repos : [];
      const pulse = activity(data.activity);

      setEntryMeta('codigo', data.activity ? `${data.activity.last30Days ?? 0} este mes` : 'GitHub');

      const list = repos.length
        ? `<div class="repos">${repos.map(repo).join('')}</div>`
        : `<p class="note">Todavía no hay proyectos por aquí.</p>`;

      card.innerHTML = pulse ? `<div>${pulse}</div>${list}` : list;
    } catch {
      setEntryMeta('codigo', 'GitHub');
      card.innerHTML = `<p class="note">No pude leer GitHub ahora mismo.</p>`;
    }
  }

  load();
  setInterval(load, 10 * 60 * 1000);
</script>
