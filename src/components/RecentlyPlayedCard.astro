---
---

<div
  id="recently-played-card"
  class="w-full max-w-sm mx-auto p-4 rounded-lg transition-opacity duration-500 opacity-0"
  style="background-color: var(--color-button-bg); border: 1px solid var(--color-button-border);"
>
  <p style="color: var(--color-text-secondary);">Cargando...</p>
</div>

<script>
  function timeAgo(playedAt: string): string {
    const diff = Math.floor((Date.now() - new Date(playedAt).getTime()) / 1000);
    if (diff < 60) return "ahora";
    if (diff < 3600) return `hace ${Math.floor(diff / 60)} min`;
    if (diff < 86400) return `hace ${Math.floor(diff / 3600)}h`;
    return `hace ${Math.floor(diff / 86400)}d`;
  }

  async function loadRecentlyPlayed() {
    const card = document.getElementById("recently-played-card");
    if (!card) return;

    try {
      const response = await fetch("/api/recently-played");
      const tracks = await response.json();

      if (!Array.isArray(tracks) || tracks.length === 0) {
        card.innerHTML = `<p style="color: var(--color-text-secondary); font-size: 0.875rem;">Sin historial reciente.</p>`;
        card.classList.remove("opacity-0");
        return;
      }

      const header = `<p class="font-bold mb-3" style="color: var(--color-text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">Últimas escuchadas</p>`;

      const rows = tracks.map((track: any) => `
        <a href="${track.songUrl}" target="_blank" rel="noopener noreferrer"
          class="flex items-center space-x-3 py-2 hover:opacity-80 transition-opacity"
          style="text-decoration: none;">
          <img
            src="${track.albumImageUrl}"
            alt="${track.title}"
            width="40" height="40"
            class="rounded flex-shrink-0"
            loading="lazy"
          />
          <div class="flex-grow min-w-0">
            <p class="truncate font-medium" style="color: var(--color-text-primary); font-size: 0.875rem;">${track.title}</p>
            <p class="truncate" style="color: var(--color-text-secondary); font-size: 0.75rem;">${track.artist}</p>
          </div>
          <span style="color: var(--color-text-secondary); font-size: 0.7rem; flex-shrink: 0;">${timeAgo(track.playedAt)}</span>
        </a>
      `).join('');

      card.innerHTML = header + rows;
      card.classList.remove("opacity-0");
    } catch {
      card.innerHTML = `<p style="color: var(--color-text-secondary);">No se pudo cargar el historial.</p>`;
      card.classList.remove("opacity-0");
    }
  }

  loadRecentlyPlayed();
</script>
