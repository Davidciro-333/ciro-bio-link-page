---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import profilePic from "../assets/profile-pic.png";
import ThemeToggle from "../components/ThemeToggle.astro";
import SocialIcons from "../components/SocialIcons.astro";
import LinkButton from "../components/LinkButton.astro";
import designSystem from "../../profile_design_system.json";
import SpotifyCard from "../components/SpotifyCard.astro";
import RecentlyPlayedCard from "../components/RecentlyPlayedCard.astro";
import PlayStationCard from "../components/PlayStationCard.astro";
import PlayStationRecentlyPlayedCard from "../components/PlayStationRecentlyPlayedCard.astro";
import GitHubCard from "../components/GitHubCard.astro";

const profile = designSystem.profile;
const mainLinks = designSystem.main_links;

// PlayStation solo se muestra en desarrollo local: Sony bloquea las peticiones
// desde IPs de datacenter (Vercel/AWS), así que en producción los endpoints se
// cuelgan (500). Pendiente: obtener los datos desde una IP residencial/fetcher
// externo y cachearlos. Cambiar a `true` cuando ese fetcher esté listo.
const showPlayStation = import.meta.env.DEV;
---

<Layout title="David">
  <ThemeToggle />

  <div class="page-container">
    <div class="profile">
      <div class="avatar-wrap">
        <div class="avatar-ring"></div>
        <div class="avatar-ring-mask"></div>
        <div class="avatar-img-wrap">
          <Image
            src={profilePic}
            alt={profile.name}
            width={92}
            height={92}
            loading="eager"
          />
        </div>
      </div>
      <h1 class="profile-name">{profile.name}</h1>
      <p class="profile-title">{profile.title}</p>
    </div>

    <SocialIcons />

    <div class="links">
      {mainLinks.map((link) => (
        <LinkButton title={link.title} url={link.url} />
      ))}
    </div>

    <SpotifyCard />
    <RecentlyPlayedCard />

    {showPlayStation && (
      <>
        <PlayStationCard />
        <PlayStationRecentlyPlayedCard />
      </>
    )}

    <GitHubCard />

    <div class="privacy">
      <a href="/privacidad">Política de privacidad</a>
    </div>
  </div>
</Layout>
